{
  "name": "nerux-design-system",
  "version": "2.0.0",
  "packageManager": "pnpm@10.26.0",
  "description": "Nerux Design System",
  "main": "dist/nerux-ds.cjs.js",
  "module": "dist/nerux-ds.es.js",
  "types": "dist/index.d.ts",
  "style": "dist/nerux-design-system.css",
  "files": [
    "dist"
  ],
  "private": false,
  "scripts": {
    "predev": "pnpm tokens:build",
    "dev": "vite",
    "prebuild": "pnpm tokens:build",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "tokens:check": "tsx scripts/build-tokens.ts --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "preview": "vite preview",
    "prestorybook": "pnpm tokens:build",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "pnpm tokens:build",
    "build-storybook": "storybook build && echo 'User-agent: *\\nDisallow: /' > storybook-static/robots.txt",
    "deploy-storybook": "pnpm build-storybook && gh-pages -d storybook-static"
  },
  "peerDependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@fission-ai/openspec": "^1.15.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-onboarding": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@react-aria/ssr": "^3.10.1",
      "@react-aria/utils": "^3.34.1"
    }
  }
}
